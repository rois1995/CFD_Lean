CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.Vec","CFDLean.Num.edgeForm_boundary_split._simp_1_1","CFDLean.Num.Internal.Sbp6.mulVec_fsum"],"kind":"theorem","module":"CFDLean.Entropy.PairFlux","name":"CFDLean.Num.edgeForm_boundary_split","raw_type":"∀ (ι κ : Type) [inst : Fintype ι] [Fintype κ] (d : Nat) (c B : ι → ι → CFDLean.Num.Vec d) (β : ι → CFDLean.Num.Vec d)\n  (F : ι → Matrix κ (Fin d) Real),\n  (∀ (i : ι), Eq (Finset.univ.sum fun k => c i k) (OfNat.ofNat 0)) →\n    (∀ (k : ι), Eq (Finset.univ.sum fun i => c i k) (β k)) →\n      (∀ (i : ι), Eq (Finset.univ.sum fun k => B i k) (β i)) →\n        let n := fun i k => HSub.hSub (c i k) (c k i);\n        let s := fun i k =>\n          HSMul.hSMul (HDiv.hDiv (OfNat.ofNat 1) (OfNat.ofNat 2)) (HSub.hSub (HAdd.hAdd (c i k) (c k i)) (B i k));\n        ∀ (i : ι),\n          Eq\n            (HAdd.hAdd\n              (HAdd.hAdd\n                (Finset.univ.sum fun k =>\n                  (HSMul.hSMul (HDiv.hDiv (OfNat.ofNat 1) (OfNat.ofNat 2)) (HAdd.hAdd (F i) (F k))).mulVec (n i k))\n                (Finset.univ.sum fun k => (HSub.hSub (F k) (F i)).mulVec (s i k)))\n              (HSMul.hSMul (HDiv.hDiv (OfNat.ofNat 1) (OfNat.ofNat 2))\n                (HAdd.hAdd (Finset.univ.sum fun k => (F k).mulVec (B i k)) ((F i).mulVec (β i)))))\n            (Finset.univ.sum fun k => (F k).mulVec (c i k))","root":true,"type":"∀ (ι κ : Type) [inst : Fintype ι] [Fintype κ] (d : ℕ) (c B : ι → ι → CFDLean.Num.Vec d) (β : ι → CFDLean.Num.Vec d)\n  (F : ι → Matrix κ (Fin d) ℝ),\n  (∀ (i : ι), ∑ k, c i k = 0) →\n    (∀ (k : ι), ∑ i, c i k = β k) →\n      (∀ (i : ι), ∑ k, B i k = β i) →\n        let n := fun i k => c i k - c k i;\n        let s := fun i k => (1 / 2) • (c i k + c k i - B i k);\n        ∀ (i : ι),\n          ∑ k, ((1 / 2) • (F i + F k)).mulVec (n i k) + ∑ k, (F k - F i).mulVec (s i k) +\n              (1 / 2) • (∑ k, (F k).mulVec (B i k) + (F i).mulVec (β i)) =\n            ∑ k, (F