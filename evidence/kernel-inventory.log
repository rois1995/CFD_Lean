HMul.hMul (OfNat.ofNat 4) d.cast) (HAdd.hAdd d.cast (OfNat.ofNat 1))))\n                  ((M.facetNodes p).sum fun i =>\n                    (M.facetNodes p).sum fun j =>\n                      CFDLean.Num.pairF (HSub.hSub (w j) (w i)) (HSub.hSub (Fs p j) (Fs p i)))))\n              (OfNat.ofNat 0))","root":true,"type":"∀ (ι C κ : Type) [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype C] [inst_3 : Fintype κ] (d : ℕ)\n  (M : CFDLean.Num.WMesh ι C d) (bd : C × Fin (d + 1) → Bool) (w : ι → κ → ℝ) (ψ : ι → CFDLean.Num.Vec d)\n  (Fs : C × Fin (d + 1) → ι → κ → ℝ),\n  M.Valid →\n    1 ≤ d →\n      M.Conforming bd →\n        let b := fun i =>\n          ∑ p,\n            if bd p = true ∧ i ∈ M.facetNodes p then ∑ j ∈ M.facetNodes p, CFDLean.Num.stdWeight d i j • Fs p j else 0;\n        ∑ i, (CFDLean.Num.dot (ψ i) (M.beta i) - CFDLean.Num.pairF (w i) (b i)) =\n          ∑ p,\n            if bd p = true then\n              1 / ↑d * ∑ i ∈ M.facetNodes p, (CFDLean.Num.dot (ψ i) (M.areaVec p) - CFDLean.Num.pairF (w i) (Fs p i)) +\n                1 / (4 * ↑d * (↑d + 1)) *\n                  ∑ i ∈ M.facetNodes p, ∑ j ∈ M.facetNodes p, CFDLean.Num.pairF (w j - w i) (Fs p j - Fs p i)\n            else 0","unsafe":false}
