CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.WMesh.c","CFDLean.Num.Vec","CFDLean.JST1.Proofs.DissGeom.dot_ite_left","CFDLean.Num.WMesh.m","CFDLean.Num.dot","CFDLean.Num.WMesh.cW","CFDLean.JST1.Proofs.DissGeom.dot_smul_l","CFDLean.Num.WMesh.ω","CFDLean.Num.WMesh.vert","CFDLean.Num.WMesh","CFDLean.JST1.Proofs.DissGeom.dot_sum_left","CFDLean.Num.WMesh.g"],"kind":"theorem","module":"CFDLean.Papers.JST1.Proofs.DissGeom","name":"CFDLean.JST1.Proofs.DissGeom.dot_c","raw_type":"∀ {ι C : Type} [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] {d : Nat} (M : CFDLean.Num.WMesh ι C d) (i k : ι)\n  (v : CFDLean.Num.Vec d),\n  Eq (CFDLean.Num.dot (M.c i k) v)\n    (Finset.univ.sum fun T =>\n      Finset.univ.sum fun a =>\n        Finset.univ.sum fun b =>\n          ite (And (Eq (DFunLike.coe (M.vert T) a) i) (Eq (DFunLike.coe (M.vert T) b) k))\n            (HMul.hMul (HMul.hMul (M.ω T) (M.m T)) (CFDLean.Num.dot (M.g T b) v)) (OfNat.ofNat 0))","root":true,"type":"∀ {ι C : Type} [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] {d : ℕ} (M : CFDLean.Num.WMesh ι C d) (i k : ι)\n  (v : CFDLean.Num.Vec d),\n  CFDLean.Num.dot (M.c i k) v =\n    ∑ T, ∑ a, ∑ b, if (M.vert T) a = i ∧ (M.vert T) b = k then M.ω T * M.m T * CFDLean.Num.dot (M.g T b) v else 0","unsafe":false}
