CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.Vec","CFDLean.Num.Internal.antisym_sum_zero"],"kind":"theorem","module":"CFDLean.Entropy.PairFlux","name":"CFDLean.Num.dissipativePairFlux_conservation","raw_type":"∀ (ι S κ : Type) [inst : Fintype ι] [DecidableEq ι] [Fintype κ] (d : Nat) (Fec : S → S → CFDLean.Num.Vec d → κ → Real)\n  (n : ι → ι → CFDLean.Num.Vec d) (u : ι → S) (ut : ι → κ → Real) (lam eps2 eps4 : ι → ι → Real) (Nstar : ι → Finset ι)\n  (b : ι → κ → Real),\n  (∀ (i k : ι), Eq (n k i) (Neg.neg (n i k))) →\n    (∀ (a b : S) (y : CFDLean.Num.Vec d), Eq (Fec a b y) (Fec b a y)) →\n      (∀ (a b : S), IsLinearMap Real (Fec a b)) →\n        (∀ (i k : ι), Eq (lam k i) (lam i k)) →\n          (∀ (i k : ι), Eq (eps2 k i) (eps2 i k)) →\n            (∀ (i k : ι), Eq (eps4 k i) (eps4 i k)) →\n              let L := fun i => (Nstar i).sum fun k => HSub.hSub (ut k) (ut i);\n              let F := fun i k =>\n                HAdd.hAdd (Fec (u i) (u k) (n i k))\n                  (HSMul.hSMul (lam i k)\n                    (HSub.hSub (HSMul.hSMul (eps2 i k) (HSub.hSub (ut i) (ut k)))\n                      (HSMul.hSMul (eps4 i k) (HSub.hSub (L i) (L k)))));\n              And (∀ (i k : ι), Eq (F k i) (Neg.neg (F i k)))\n                (Eq (Finset.univ.sum fun i => HSub.hSub (Neg.neg (Finset.univ.sum fun k => F i k)) (b i))\n                  (Neg.neg (Finset.univ.sum fun i => b i)))","root":true,"type":"∀ (ι S κ : Type) [inst : Fintype ι] [DecidableEq ι] [Fintype κ] (d : ℕ) (Fec : S → S → CFDLean.Num.Vec d → κ → ℝ)\n  (n : ι → ι → CFDLean.Num.Vec d) (u : ι → S) (ut : ι → κ → ℝ) (lam eps2 eps4 : ι → ι → ℝ) (Nstar : ι → Finset ι)\n  (b : ι → κ → ℝ),\n  (∀ (i k : ι), n k i = -n i k) →\n    (∀ (a b : S) (y : CFDLean.Num.Vec d), Fec a b y = Fec b a y) →\n      (∀ (a b : S), IsLinearMap ℝ (Fec a b)) →\n        (∀ (i k : ι), lam k i = lam i k) →\n          (∀ (i k : ι), eps2 k i = eps2 i k) →\n            (∀ (i k : ι), eps4 k i = e