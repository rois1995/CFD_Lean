CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.WMesh.areaVec","CFDLean.Num.Internal.Sbp6.beta_bd","CFDLean.Num.Vec","CFDLean.Num.WMesh.Valid","CFDLean.Num.WMesh.Conforming","CFDLean.Num.WMesh.Closed","CFDLean.Num.WMesh.B","CFDLean.Num.WMesh.beta","CFDLean.Num.WMesh.facetNodes","CFDLean.Num.Internal.Sbp6.B_bd","CFDLean.Num.WMesh"],"kind":"theorem","module":"CFDLean.Geometry.MeshBoundary","name":"CFDLean.Num.WMesh.conforming_boundary","raw_type":"∀ (ι C : Type) [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] (d : Nat) (M : CFDLean.Num.WMesh ι C d)\n  (bd : Prod C (Fin (HAdd.hAdd d (OfNat.ofNat 1))) → Bool),\n  M.Valid →\n    LE.le (OfNat.ofNat 1) d →\n      M.Conforming bd →\n        And\n          (∀ (i : ι),\n            Eq (M.beta i)\n              (Finset.univ.sum fun p =>\n                ite (And (Eq (bd p) true) (Membership.mem (M.facetNodes p) i))\n                  (HSMul.hSMul (HDiv.hDiv (OfNat.ofNat 1) d.cast) (M.areaVec p)) (OfNat.ofNat 0)))\n          (And\n            (∀ (i k : ι),\n              Eq (M.B i k)\n                (Finset.univ.sum fun p =>\n                  ite\n                    (And (Eq (bd p) true) (And (Membership.mem (M.facetNodes p) i) (Membership.mem (M.facetNodes p) k)))\n                    (HSMul.hSMul\n                      (HDiv.hDiv (HAdd.hAdd (OfNat.ofNat 1) (ite (Eq i k) (OfNat.ofNat 1) (OfNat.ofNat 0)))\n                        (HMul.hMul d.cast (HAdd.hAdd d.cast (OfNat.ofNat 1))))\n                      (M.areaVec p))\n                    (OfNat.ofNat 0)))\n            (∀ (i : ι),\n              (∀ (p : Prod C (Fin (HAdd.hAdd d (OfNat.ofNat 1)))),\n                  Eq (bd p) true → Not (Membership.mem (M.facetNodes p) i)) →\n                M.Closed i))","root":true,"type":"∀ (ι C : Type) [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] (d : ℕ) (M : CFDLean.Num.WMesh ι C d)\n  (bd : C × Fin (d + 1) → Bool),\n  M.Valid →\n    1 ≤ d →\n      M.Conforming bd →\n        (∀ (i : ι), M.beta i = ∑ p, if bd p = true ∧ i ∈ M.facetNodes p then (1 / ↑d) • M.areaVec p else 0) ∧\n          (∀ (i k : ι),\n              M.B i k =\n                ∑ p,\n                  if bd p = true ∧ i ∈ M.facetNodes p ∧ k ∈ M.facetNodes p then\n                    ((1 + if i = k then 1 else 0) / (↑d * (↑d + 1))) • M.areaVec p\n                  else 0) ∧\n            ∀ (i : ι), (∀ (p : C × Fin (d + 1)), bd p = true → i ∉ M.facetNodes p) → M.Closed i","unsafe":false}
