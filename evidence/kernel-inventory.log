CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.WMesh.areaVec","CFDLean.Num.Internal.Sbp6.beta_bd","CFDLean.Num.Vec","CFDLean.Num.WMesh.Valid","CFDLean.Num.WMesh.Conforming","CFDLean.Num.Internal.Sbp6.dot_sum_r","CFDLean.Num.Internal.pairF_sum'","CFDLean.Num.Internal.Sbp6.face_identity","CFDLean.Num.Internal.Sbp6.card_facetNodes","CFDLean.Num.dot","CFDLean.Num.Internal.pairF_smul'","CFDLean.Num.pairF","CFDLean.Num.WMesh.beta","CFDLean.Num.Internal.Sbp6.sum_bd_mem","CFDLean.Num.WMesh.facetNodes","CFDLean.Num.WMesh","CFDLean.Num.Internal.Sbp6.dot_ite_r","CFDLean.Num.Internal.Sbp6.pairF_ite","CFDLean.Num.stdWeight","CFDLean.Num.Internal.Sbp6.dot_smul_r'"],"kind":"theorem","module":"CFDLean.Entropy.PairFlux","name":"CFDLean.Num.WMesh.standardClosure_entropy","raw_type":"∀ (ι C κ : Type) [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype C] [inst_3 : Fintype κ] (d : Nat)\n  (M : CFDLean.Num.WMesh ι C d) (bd : Prod C (Fin (HAdd.hAdd d (OfNat.ofNat 1))) → Bool) (w : ι → κ → Real)\n  (ψ : ι → CFDLean.Num.Vec d) (Fs : Prod C (Fin (HAdd.hAdd d (OfNat.ofNat 1))) → ι → κ → Real),\n  M.Valid →\n    LE.le (OfNat.ofNat 1) d →\n      M.Conforming bd →\n        let b := fun i =>\n          Finset.univ.sum fun p =>\n            ite (And (Eq (bd p) true) (Membership.mem (M.facetNodes p) i))\n              ((M.facetNodes p).sum fun j => HSMul.hSMul (CFDLean.Num.stdWeight d i j) (Fs p j)) (OfNat.ofNat 0);\n        Eq (Finset.univ.sum fun i => HSub.hSub (CFDLean.Num.dot (ψ i) (M.beta i)) (CFDLean.Num.pairF (w i) (b i)))\n          (Finset.univ.sum fun p =>\n            ite (Eq (bd p) true)\n              (HAdd.hAdd\n                (HMul.hMul (HDiv.hDiv (OfNat.ofNat 1) d.cast)\n                  ((M.facetNodes p).sum fun i =>\n                    HSub.hSub (CFDLean.Num.dot (ψ i) (M.areaVec p)) (CFDLean.Num.pairF (w i) (Fs p i))))\n                (HMul.hMul\n                  (HDiv.hDiv (OfNat.ofNat 1)\n                    (HMul.hMul (HMul.hMul (OfNat.ofNat 4) d.cast) (HAdd.hAdd d.cast (OfNat.ofNat 1))))\n                  ((M.facetNodes p).sum fun i =>\n                    (M.facetNodes p).sum fun j =>\n                      CFDLean.Num.pairF (HSub.hSub (w j) (w i)) (HSub.hSub (Fs p j) (Fs p i)))))\n              (OfNat.ofNat 0))","root":true,"type":"∀ (ι C κ : Type) [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype C] [inst_3 : Fintype κ] (d : ℕ)\n  (M : CFDLean.Num.WMesh ι C d) (bd : C × Fin (d + 1) → Bool) (w : ι → κ → ℝ) (ψ : ι → CFDLean.Num.Vec d)\n  (Fs : C × Fin (d + 1) → ι → κ → ℝ),\n  M.Valid →\n    1 ≤ d →\n      M.Conforming bd →\n        let b := fun i =>\n          ∑ p,\n            if bd p = true ∧ i ∈ M.facetNodes p then ∑ j ∈ M.facetNodes p, CFDLean.Num.stdWeight d i j • Fs p j else 0;\n        ∑ i, (CFDLean.Num.dot (ψ i) (M.beta i) - CFDLean.Num.pairF (w i) (b i)) =\n          ∑ p,\n            if bd p = true then\n              1 / ↑d * ∑ i ∈ M.facetNodes p, (CFDLean.Num.dot (ψ i) (M.areaVec p) - CFDLean.Num.pairF (w i) (Fs p i)) +\n                1 / (4 * ↑d * (↑d + 1)) *\n                  ∑ i ∈ M.facetNodes p, ∑ j ∈ M.facetNodes p, CFDLean.Num.pairF (w j - w i) (Fs p j - Fs p i)\n            else 0","unsafe":false}
