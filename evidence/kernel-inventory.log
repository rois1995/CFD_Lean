CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.JST1.Gas.γ","CFDLean.Num.Vec","CFDLean.JST1.State","CFDLean.JST1.vel","CFDLean.JST1.ismailRoe.match_1","CFDLean.JST1.ismailRoe","CFDLean.Num.dot","CFDLean.JST1.ismailRoe._proof_1","CFDLean.JST1.rho","CFDLean.JST1.pressure","CFDLean.Num.logMean","CFDLean.JST1.Channel","CFDLean.JST1.Gas"],"kind":"theorem","module":"CFDLean.Papers.JST1.Proofs.Item2Euler","name":"CFDLean.JST1.ismailRoe.eq_1","root":true,"type":"∀ {d : ℕ} (g : CFDLean.JST1.Gas) (Ua Ub : CFDLean.JST1.State d) (y : CFDLean.Num.Vec d),\n  CFDLean.JST1.ismailRoe g Ua Ub y = fun c =>\n    match c with\n    | CFDLean.JST1.Channel.mass =>\n      (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) + √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) / 2 *\n          CFDLean.Num.logMean √(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua)\n            √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub) *\n        CFDLean.Num.dot\n          (fun α =>\n            (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                  √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                2 /\n              ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                  √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                2))\n          y\n    | CFDLean.JST1.Channel.momentum α =>\n      (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) + √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) / 2 *\n              CFDLean.Num.logMean √(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua)\n                √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub) *\n            (fun α =>\n                (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                      √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                    2 /\n                  ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                      √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                    2))\n              α *\n          CFDLean.Num.dot\n            (fun α =>\n              (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                    √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                  2 /\n                ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                    √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                  2))\n            y +\n        (√(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua) + √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub)) /\n              2 /\n            ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n              2) *\n          y α\n    | CFDLean.JST1.Channel.energy =>\n      (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) + √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) / 2 *\n            CFDLean.Num.logMean √(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua)\n              √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub) *\n          (g.γ *\n                ((g.γ + 1) / (2 * g.γ) *\n                    (CFDLean.Num.logMean √(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua)\n                        √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub) /\n                      CFDLean.Num.logMean √(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua)\n                        √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) +\n                  (g.γ - 1) / (2 * g.γ) *\n                    ((√(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua) +\n                          √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub)) /\n                        2 /\n                      ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                          √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                        2))) /\n              ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                      √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                    2 *\n                  CFDLean.Num.logMean √(CFDLean.JST1.rho Ua * CFDLean.JST1.pressure g Ua)\n                    √(CFDLean.JST1.rho Ub * CFDLean.JST1.pressure g Ub) *\n                (g.γ - 1)) +\n            (CFDLean.Num.dot\n                (fun α =>\n                  (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                        √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                      2 /\n                    ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                        √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                      2))\n                fun α =>\n                (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                      √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                    2 /\n                  ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                      √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                    2)) /\n              2) *\n        CFDLean.Num.dot\n          (fun α =>\n            (√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) * CFDLean.JST1.vel Ua α +\n                  √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub) * CFDLean.JST1.vel Ub α) /\n                2 /\n              ((√(CFDLean.JST1.rho Ua / CFDLean.JST1.pressure g Ua) +\n                  √(CFDLean.JST1.rho Ub / CFDLean.JST1.pressure g Ub)) /\n                2))\n          y","unsafe":false}
