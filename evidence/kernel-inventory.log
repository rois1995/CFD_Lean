\n                                (HMul.hMul d.cast (HAdd.hAdd d.cast (OfNat.ofNat 1))))) →\n                let N := fun q => HSMul.hSMul (aq q) (M.areaVec (fq q));\n                And (∀ (i : ι), Eq (Finset.univ.sum fun q => HSMul.hSMul (φ q i) (N q)) (M.beta i))\n                  (∀ (i k : ι), Eq (Finset.univ.sum fun q => HSMul.hSMul (HMul.hMul (φ q i) (φ q k)) (N q)) (M.B i k))","root":true,"type":"∀ (ι C Q : Type) [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] [inst_2 : DecidableEq C] [inst_3 : Fintype Q]\n  (d : ℕ) (M : CFDLean.Num.WMesh ι C d) (bd : C × Fin (d + 1) → Bool) (fq : Q → C × Fin (d + 1)) (aq : Q → ℝ)\n  (φ : Q → ι → ℝ),\n  M.Valid →\n    1 ≤ d →\n      M.Conforming bd →\n        (∀ (q : Q), bd (fq q) = true) →\n          (∀ (q : Q), ∀ k ∉ M.facetNodes (fq q), φ q k = 0) →\n            (∀ (p : C × Fin (d + 1)),\n                bd p = true → ∀ i ∈ M.facetNodes p, (∑ q, if fq q = p then aq q * φ q i else 0) = 1 / ↑d) →\n              (∀ (p : C × Fin (d + 1)),\n                  bd p = true →\n                    ∀ i ∈ M.facetNodes p,\n                      ∀ k ∈ M.facetNodes p,\n                        (∑ q, if fq q = p then aq q * φ q i * φ q k else 0) =\n                          (1 + if i = k then 1 else 0) / (↑d * (↑d + 1))) →\n                let N := fun q => aq q • M.areaVec (fq q);\n                (∀ (i : ι), ∑ q, φ q i • N q = M.beta i) ∧ ∀ (i k : ι), ∑ q, (φ q i * φ q k) • N q = M.B i k","unsafe":false}
