CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.PhysicalJacobian.velocity","CFDLean.Coordinates.decode","CFDLean.Conservative.energy","CFDLean.PhysicalJacobian.velocity._proof_1","CFDLean.PhysicalJacobian.coordinatePressure","CFDLean.Coordinates.decode_encode","CFDLean.squareSum","CFDLean.Conservative.mk","CFDLean.Coordinates.decode._proof_1","CFDLean.Coordinates.dot_three","CFDLean.PhysicalJacobian.normalMomentum._proof_4","CFDLean.PhysicalJacobian.normalIncrement","CFDLean.PhysicalJacobian.jacobian","CFDLean.Conservative.density","CFDLean.Conservative.momentum","CFDLean.PhysicalJacobian.normalMomentum","CFDLean.Coordinates.encode._proof_1","CFDLean.dot","CFDLean.PhysicalJacobian.pressureDifferential","CFDLean.PhysicalJacobian.normalMomentum._proof_2","CFDLean.Coordinates.squareSum_three","CFDLean.Coordinates.encode","CFDLean.PhysicalJacobian.normalMomentum._proof_3","CFDLean.PhysicalJacobian.enthalpy","CFDLean.PhysicalJacobian.pressureDifferential._proof_1","CFDLean.Vector","CFDLean.Conservative.pressure._proof_1","CFDLean.Conservative","CFDLean.Conservative.pressure","CFDLean.PhysicalJacobian.normalMomentum._proof_1","CFDLean.Coordinates.StateCoordinates","CFDLean.PhysicalJacobian.projection"],"kind":"theorem","module":"CFDLean.Physics.Euler.PhysicalJacobian","name":"CFDLean.PhysicalJacobian.jacobian_action","raw_type":"∀ (γ : Real) (U V : CFDLean.Conservative (OfNat.ofNat 3)) (n : CFDLean.Vector (OfNat.ofNat 3)),\n  let u := fun i => HDiv.hDiv (U.momentum i) U.density;\n  let q := CFDLean.dot u n;\n  let b := HSub.hSub (CFDLean.dot V.momentum n) (HMul.hMul q V.density);\n  let dp :=\n    HMul.hMul (HSub.hSub γ (OfNat.ofNat 1))\n      (HAdd.hAdd (HSub.hSub V.energy (CFDLean.dot u V.momentum))\n        (HMul.hMul (HDiv.hDiv (CFDLean.squareSum u) (OfNat.ofNat 2)) V.density));\n  let H := HDiv.hDiv (HAdd.hAdd U.energy (CFDLean.Conservative.pressure γ U)) U.density;\n  Eq\n    (DFunLike.coe (CFDLean.PhysicalJacobian.jacobian γ (CFDLean.Coordinates.encode U) n) (CFDLean.Coordinates.encode V))\n    (CFDLean.Coordinates.encode\n      { density := CFDLean.dot V.momentum n,\n        momentum := fun i =>\n          HAdd.hAdd (HAdd.hAdd (HMul.hMul q (V.momentum i)) (HMul.hMul (u i) b)) (HMul.hMul dp (n i)),\n        energy := HAdd.hAdd (HMul.hMul q (HAdd.hAdd V.energy dp)) (HMul.hMul H b) })","root":true,"type":"∀ (γ : ℝ) (U V : CFDLean.Conservative 3) (n : CFDLean.Vector 3),\n  let u := fun i => U.momentum i / U.density;\n  let q := CFDLean.dot u n;\n  let b := CFDLean.dot V.momentum n - q * V.density;\n  let dp := (γ - 1) * (V.energy - CFDLean.dot u V.momentum + CFDLean.squareSum u / 2 * V.density);\n  let H := (U.energy + CFDLean.Conservative.pressure γ U) / U.density;\n  (CFDLean.PhysicalJacobian.jacobian γ (CFDLean.Coordinates.encode U) n) (CFDLean.Coordinates.encode V) =\n    CFDLean.Coordinates.encode\n      { density := CFDLean.dot V.momentum n, momentum := fun i => q * V.momentum i + u i * b + dp * n i,\n        energy := q * (V.energy + dp) + H * b }","unsafe":false}
