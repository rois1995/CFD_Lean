CFDLEAN_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"direct":["CFDLean.Num.Internal.Sbp6.mulVec_ite","CFDLean.Num.WMesh.areaVec","CFDLean.Num.Internal.Sbp6.beta_bd","CFDLean.Num.Vec","CFDLean.Num.WMesh.Valid","CFDLean.Num.stdWeight._proof_1","CFDLean.Num.WMesh.Conforming","CFDLean.Num.WMesh.standardClosure_linear._simp_1_1","CFDLean.Num.WMesh.B","CFDLean.Num.WMesh.standardClosure_linear._simp_1_6","CFDLean.Num.WMesh.beta","CFDLean.Num.WMesh.facetNodes","CFDLean.Num.Internal.Sbp6.B_bd","CFDLean.Num.WMesh","CFDLean.Num.WMesh.standardClosure_linear._simp_1_5","CFDLean.Num.WMesh.standardClosure_linear._simp_1_4","CFDLean.Num.stdWeight"],"kind":"theorem","module":"CFDLean.Entropy.PairFlux","name":"CFDLean.Num.WMesh.standardClosure_linear","raw_type":"∀ (ι C κ : Type) [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype C] [Fintype κ] (d : Nat)\n  (M : CFDLean.Num.WMesh ι C d) (bd : Prod C (Fin (HAdd.hAdd d (OfNat.ofNat 1))) → Bool)\n  (F : ι → Matrix κ (Fin d) Real),\n  M.Valid →\n    LE.le (OfNat.ofNat 1) d →\n      M.Conforming bd →\n        And\n          (∀ (i : ι),\n            Eq\n              (Finset.univ.sum fun k =>\n                (F k).mulVec\n                  (HSMul.hSMul (HDiv.hDiv (OfNat.ofNat 1) (OfNat.ofNat 2))\n                    (HAdd.hAdd (M.B i k) (ite (Eq i k) (M.beta i) (OfNat.ofNat 0)))))\n              (Finset.univ.sum fun p =>\n                ite (And (Eq (bd p) true) (Membership.mem (M.facetNodes p) i))\n                  ((M.facetNodes p).sum fun j => HSMul.hSMul (CFDLean.Num.stdWeight d i j) ((F j).mulVec (M.areaVec p)))\n                  (OfNat.ofNat 0)))\n          (∀ (i j : ι),\n            Ne i j →\n              Eq (CFDLean.Num.stdWeight d i i)\n                (HMul.hMul (HAdd.hAdd d.cast (OfNat.ofNat 3)) (CFDLean.Num.stdWeight d i j)))","root":true,"type":"∀ (ι C κ : Type) [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype C] [Fintype κ] (d : ℕ)\n  (M : CFDLean.Num.WMesh ι C d) (bd : C × Fin (d + 1) → Bool) (F : ι → Matrix κ (Fin d) ℝ),\n  M.Valid →\n    1 ≤ d →\n      M.Conforming bd →\n        (∀ (i : ι),\n            ∑ k, (F k).mulVec ((1 / 2) • (M.B i k + if i = k then M.beta i else 0)) =\n              ∑ p,\n                if bd p = true ∧ i ∈ M.facetNodes p then\n                  ∑ j ∈ M.facetNodes p, CFDLean.Num.stdWeight d i j • (F j).mulVec (M.areaVec p)\n                else 0) ∧\n          ∀ (i j : ι), i ≠ j → CFDLean.Num.stdWeight d i i = (↑d + 3) * CFDLean.Num.stdWeight d i j","unsafe":false}
