STMT CFDLean.Num.WMesh.dissGeom_edge :: ∀ (ι C : Type) [Fintype ι] [inst : DecidableEq ι] [inst_1 : Fintype C] (d : ℕ)
  (M : CFDLean.Num.WMesh ι C d),
