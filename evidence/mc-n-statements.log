  M.Valid →
    1 ≤ d →
      M.Conforming bd →
        (∀ (i : ι), M.beta i = ∑ p, if bd p = Bool.true ∧ i ∈ M.facetNodes p then (1 / ↑d) • M.areaVec p else 0) ∧
          (∀ (i k : ι),
              M.B i k =
                ∑ p,
                  if bd p = Bool.true ∧ i ∈ M.facetNodes p ∧ k ∈ M.facetNodes p then
