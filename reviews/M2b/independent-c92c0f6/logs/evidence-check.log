M2-J CFDLean.PhysicalJacobian.jacobian_action ∀ (γ : ℝ) (U V : CFDLean.Conservative 3) (n : CFDLean.Vector 3),
  let u := fun i => U.momentum i / U.density;
  let q := CFDLean.dot u n;
  let b := CFDLean.dot V.momentum n - q * V.density;
  let dp := (γ - 1) * (V.energy - CFDLean.dot u V.momentum + CFDLean.squareSum u / 2 * V.density);
  let H := (U.energy + CFDLean.Conservative.pressure γ U) / U.density;
  (CFDLean.PhysicalJacobian.jacobian γ (CFDLean.Coordinates.encode U) n) (CFDLean.Coordinates.encode V) =
    CFDLean.Coordinates.encode
      { density := CFDLean.dot V.momentum n, momentum := fun i => q * V.momentum i + u i * b + dp * n i,
        energy := q * (V.energy + dp) + H * b }
