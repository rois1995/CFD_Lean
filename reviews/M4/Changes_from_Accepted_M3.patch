++      · exact ⟨1,rfl⟩
++      · exact ⟨2,rfl⟩
++    · apply convexHull_mono
++      rintro _ ⟨i, hi, rfl⟩
++      simp only [sharedNodes, Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton] at hi
++      rcases hi with rfl | rfl | rfl
++      · exact ⟨0,rfl⟩
++      · exact ⟨2,rfl⟩
++      · exact ⟨1,rfl⟩
